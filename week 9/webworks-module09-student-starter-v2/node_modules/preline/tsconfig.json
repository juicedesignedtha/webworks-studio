{
	"compilerOptions": {
		"baseUrl": "./",
		"rootDir": "./src",
		"outDir": "./dist/",
		"noImplicitAny": true,
		"module": "commonjs",
		"target": "es2015",
		"allowJs": true,
		"moduleResolution": "node",
		"ignoreDeprecations": "6.0",
		"esModuleInterop": true
	},
	"include": ["src/**/*", "global.d.ts"],
	"exclude": ["node_modules", "**/*.spec.ts"]
}
